@inproceedings{pareng26,
   abstract = {Bioinformatics algorithms sit between raw biological measurement and biological interpretation, and the past decade has changed what they are asked to do. Methods that were built to describe existing data are now being used to propose new molecules, new edits and new genomes. This review examines that shift across three areas of biotechnology: CRISPR-Cas genome editing, machine-learning-assisted drug discovery, and the computational design of bacteriophages. A rapid review following the PRISMA 2020 reporting standard was conducted in PubMed/MEDLINE, with three Boolean blocks covering the period from January 2012 to September 2026. The search returned 18,868 unique records, of which 178 relevance-ranked records were screened at title and abstract level and 84 were assessed in full text. Twenty-one studies met the eligibility criteria from database searching, and a further 44 methodological and primary sources were added through citation chaining, giving 65 sources in the synthesis. Every source was verified against its PubMed identifier and its DOI record before inclusion. For each of the three areas the review states the governing objective function, presents the scoring or likelihood equation in explicit notation, and gives the corresponding algorithm in pseudocode. The comparison shows that the three areas share one computational skeleton: a learned or empirically calibrated score over candidate sequences or structures, a search procedure over a combinatorially large candidate space, and a constraint term that keeps proposals inside a region where laboratory work is plausible. The differences between the areas lie in how well the score is calibrated and in how expensive it is to test a proposal experimentally. Guide RNA scoring is the most mature of the three, with orthogonal empirical measurements available for calibration; generative phage design is the least mature, and its plausibility scores have not yet been anchored to comparable experimental measurement. The review argues that reporting practice, not model capacity, is now the limiting factor for reproducibility, and it sets out what computational and experimental groups working in resource-constrained settings should report so that algorithm-generated candidates can be independently evaluated.},
   author = {Arli Aditya Parikesit},
   city = {Konya},
   editor = {Bayram Akdemir},
   institution = {Konya Technical University and IKSAD Institute},
   booktitle = {international conference on ENGINEERING SCIENCES},
   keywords = {AI-designed bacteriophages,AI-generated drug discovery,Bioinformatics algorithms,CRISPR-Cas,antibiotic resistance},
   month = {10},
   pages = {669-687},
   publisher = {IKSAD},
   title = {ALGORITHMIC PERSPECTIVES IN BIOINFORMATICS: A REVIEW OF COMPUTATIONAL METHODS INTERPRETING EMERGING TRENDS IN BIOTECHNOLOGY},
   url = {https://ices.kongrepark.org/library https://www.researchgate.net/publication/415565594_ALGORITHMIC_PERSPECTIVES_IN_BIOINFORMATICS_A_REVIEW_OF_COMPUTATIONAL_METHODS_INTERPRETING_EMERGING_TRENDS_IN_BIOTECHNOLOGY},
   year = {2026}
}
@inbook{Mey2025,
   abstract = {
Abstract. This study explores the role of AI-driven analysis and methylation difference regions (DMR) in Alzheimer’s Disease-related genes (APP, APOE, PSEN1, PSEN2, MAPT, and TREM2. By utilizing public transcriptomic datasets (GSE48350, GSE11882) and methylation datasets (GSE244352), a multilayer perceptron (MLP) machine learning model was used for AD detection based on gene expression and demographic factors. DMR analysis identified significant methylation changes in target genes, followed by genomic annotation and KEGG pathway enrichment. The analysis revealed significant hyper- and hypo-methylation patterns in PSEN1 and MAPT genes, confirmed to be involved in AD-related pathways like tau hyperphosphorylation, mitochondrial dysfunction, neuroinflammation, and amyloid-beta formation. The MLP model showed moderate sensitivity and high specificity for AD classification despite dataset imbalance. This research shows the potential of integrating epigenetics with AI for enhanced AD understanding and diagnostic tool development, while highlighting the need for a larger, more diverse dataset for future validation 
Keywords: Alzheimer’s Disease, DNA Methylation, DMR analysis, Multilayer Perceptron (MLP), KEGG Pathway Analysis, Artificial Intelligence (AI) 
Availability of data and materials 
The dataset obtained in order to conduct DMR analysis, AI-driven analysis and MLP is gathered from GSE244352, GSE48350 and GSE11882. These datasets are open sourced and available for public use in the GEO database. Furthermore the coding materials for DMR is available through this github repository (https://github.com/theverie/DMR-Analysis.git)  and for the AI model and MLP is available through this github repository (https://github.com/MBL04/AI-ML-AD-Prediction). 

Acknowledgments 
The authors of this paper would like to collectively express their utmost gratitude towards the Department of Research and Community service of Indonesia International Institute for Life Sciences (LPPM i3L) for their heartfelt support. Thanks also go to Kanehisa Laboratories of University of Kyoto, Japan, for providing permission in using the selected figures from the KEGG database.
},
   author = {Theshia Veronica Kusuma Yun Mey and Michael Branson Lee and Angelo Christiano Aouad Tomodok and Nathaniel Emmanuel Muliana and Dhea Priskila and Muammar Sadrawi and Arli Aditya Parikesit},
   city = {Istanbul},
   doi = {10.5281/zenodo.18070507},
   editor = {Aminu ISYAKU},
   isbn = {978-625-93563-8-9},
   booktitle = {ADVANCED THERAPEUTICS AND DISEASE BIOLOGY: MOLECULAR DIAGNOSTICS AND IMMUNITY- 2025},
   month = {12},
   pages = {57-86},
   publisher = {Halic Publishing House},
   title = {Detection of Alzheimer's Disease through AI-Driven and Methylation Difference Region Analysis of Significant Epigenetic Modifications in APP, PSEN1, PSEN2, APOE, MAPT, and TREM2 Genes },
   url = {https://www.halicyayinevi.com/medical https://www.researchgate.net/publication/399420885_DETECTION_OF_ALZHEIMER'S_DISEASE_THROUGH_AI-DRIVEN_AND_METHYLATION_DIFFERENCE_REGION_ANALYSIS_OF_SIGNIFICANT_EPIGENETIC_MODIFICATIONS_IN_APP_PSEN1_PSEN2_APOE_MAPT_AND_TREM2_GENES},
   year = {2025}
}
@article{Fugaha2024,
   abstract = {This study aimed to investigate aberrant miRNA expression in colon cancer using a bioinformatics pipeline. miRNA expression and clinical data were retrieved from the National Cancer Institute's Cancer Genome Atlas Program (TCGA) database and were processed using DESeq2. 107 upregulated and 189 downregulated miRNAs are identified to be significantly correlated with the presence of colon cancer. Five of the most significant overexpressed and under-expressed miRNAs were discussed as potential colon cancer diagnosis and treatment biomarkers. The clinical implications of these findings are substantial, as the identified miRNAs could serve as non-invasive biomarkers for early detection and prognosis of colon cancer. Furthermore, these miRNAs may provide insights into the molecular mechanisms underlying colon cancer progression, potentially unveiling new therapeutic targets. Future studies should focus on validating these miRNAs in larger, independent cohorts and exploring their functional roles in colon cancer biology. This could pave the way for developing miRNA-based diagnostic tools and personalized treatment strategies, ultimately improving patient outcomes.},
   author = {Daniel Ryan Fugaha and Dhannyo Putta and Dennis Lunoto and Arli Aditya Parikesit},
   doi = {10.1109/ICIC64337.2024.10957168},
   isbn = {979-8-3315-1760-1},
   journal = {2024 Ninth International Conference on Informatics and Computing (ICIC)},
   month = {10},
   pages = {1-4},
   publisher = {IEEE},
   title = {MicroRNA Expression Profiling in Colorectal Carcinoma: Identification and Validation of Novel Diagnostic, Prognostic and Predictive Biomarkers},
   url = {https://ieeexplore.ieee.org/document/10957168/},
   year = {2024}
}
